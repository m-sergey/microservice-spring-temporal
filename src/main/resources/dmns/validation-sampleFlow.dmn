<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:biodi="http://bpmn.io/schema/dmn/biodi/2.0" id="sampleFlow-validation" name="sampleFlow-validation" namespace="http://camunda.org/schema/1.0/dmn" exporter="Camunda Modeler" exporterVersion="4.12.0">
  <decision id="sampleFlow_validation" name="sampleFlow-validation">
    <decisionTable hitPolicy="FIRST">
      <input id="Input_1" label="user_id">
