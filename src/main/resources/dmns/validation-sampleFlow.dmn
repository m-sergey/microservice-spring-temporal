      <output id="Output_1" name="result" typeRef="string" />
      <rule id="DecisionRule_033mvzr">
        <inputEntry id="UnaryTests_0u0wvqz">
          <text>&gt; 0</text>
        </inputEntry>
        <inputEntry id="UnaryTests_11ulnf6">
          <text>&lt; 1000000</text>
